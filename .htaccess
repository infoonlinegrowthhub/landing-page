# =====================================================================
# Production Hardening, Clean Extensionless URLs, Canonical 301 & GEO
# =====================================================================

Options -Indexes -MultiViews
DirectoryIndex index.php

# Block Sensitive Dotfiles, SQL Dumps, and Config Files
<FilesMatch "(^\.|\.(env|git|sql|bak|ini|log|sh)$|^composer\.(json|lock)$|^package(-lock)?\.json$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    <FilesMatch "\.(ico|png|svg|webp|txt)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to /config/ and /database/ directories
    RewriteRule ^(config|database)/ - [F,L]

    # 1. Strict Canonical 301 Redirect (www -> non-www)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

    # 2. Redirect /index.php and /index to clean root (/ or /landing-page/)
    RewriteCond %{THE_REQUEST} \s(/+(?:landing-page/)?)index(?:\.php)?[\s?] [NC]
    RewriteRule ^index(?:\.php)?$ %1 [R=301,L]

    # 3. Redirect /admin/index.php and /admin/index to clean /admin/
    RewriteCond %{THE_REQUEST} \s(/+(?:landing-page/)?)admin/index(?:\.php)?[\s?] [NC]
    RewriteRule ^admin/index(?:\.php)?$ %1admin/ [R=301,L]

    # 4. Redirect any direct GET request with .php extension to clean extensionless URL
    RewriteCond %{REQUEST_METHOD} =GET
    RewriteCond %{THE_REQUEST} \s(/+(?:landing-page/)?)([^\s?]+)\.php[\s?] [NC]
    RewriteRule ^(.+)\.php$ %1$1 [R=301,L]

    # 5. HTTP 410 Gone for Permanently Removed Content & Legacy/Spam Routes
    RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|old-store|retired-product|deprecated)(/.*)?$ 410.php [L]

    # 6. Dynamic /llms.txt and /sitemap.xml Rewrites
    RewriteRule ^llms\.txt$ llms.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # 7. Clean Product Buy Slug Route: /buy/{product-slug} -> go.php?slug={product-slug}
    RewriteRule ^buy/([a-zA-Z0-9_-]+)/?$ go.php?slug=$1 [L,QSA]

    # 8. Clean Extensionless URL Resolution (e.g. /admin/products -> /admin/products.php, /go -> /go.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>
